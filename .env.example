# Copy this file to .env and fill in the values. Never commit .env.

# Required. Embeds each company and writes the thesis readback (Nicrron, https://nicrron.ai).
NICRRON_API_KEY=

# Required. Where the Next.js app finds the ranking service. Not a secret.
THESIS_RANKER_URL=http://127.0.0.1:8001

# Optional. Exports a trace for each run to PRISM by Block Convey. Leave empty to skip.
PRISMTRACE_API_KEY=

# Only for services/thesis/pull.py, which buys the full company pool. The app itself never calls akta.pro.
AKTA_API_KEY=
